# Database — SQLAlchemy/Alembic use postgresql+asyncpg://; asyncpg pool strips +asyncpg
DATABASE_URL=postgresql+asyncpg://camppulse:devpassword@localhost:5432/camppulse_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=minimum_32_char_secret_key_change_me

# Mapbox
MAPBOX_TOKEN=pk.your_mapbox_token_here

# OpenRouteService (fallback routing)
OPENROUTE_SERVICE_API_KEY=your_ors_api_key_here

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=camppulse-incidents
R2_PUBLIC_URL=https://pub-your-id.r2.dev
