# Database
# SQLAlchemy/Alembic use postgresql+asyncpg://; asyncpg pool strips +asyncpg at runtime
DATABASE_URL=postgresql+asyncpg://camppulse:devpassword@localhost:5432/camppulse_dev

# Redis (local dev — use redis://; production may use rediss:// Upstash)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=minimum_32_char_secret_key_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mapbox
MAPBOX_TOKEN=pk.eyJ...
MAPBOX_STYLE_URL=mapbox://styles/camppulse/...

# Cloudflare R2 (S3-compatible object storage — incident photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=camppulse-uploads
R2_PUBLIC_BASE_URL=https://uploads.camppulse.ng

# External routing
OPENROUTE_SERVICE_API_KEY=ors_...

# Feature flags
CONGESTION_DETECTION_ENABLED=true
PREDICTIVE_HOTSPOTS_ENABLED=true
OFFLINE_ROUTE_CACHE_ENABLED=true

# Thresholds (override defaults from constants package)
CONGESTION_THRESHOLD=50
DETECTION_WINDOW_SECONDS=90
REVALIDATION_WINDOW_SECONDS=60

# Web (local Vite dev)
VITE_API_URL=http://localhost:8000
